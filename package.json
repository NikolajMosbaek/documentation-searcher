{
  "name": "documentation-searcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "playground": "agentsplayground -e http://localhost:3978/api/messages -c emulator",
    "test": "node --import tsx --test src/core/*.test.ts src/*.test.ts",
    "seed": "tsx src/seed.ts",
    "soak": "tsx src/soak.ts",
    "judge-eval": "tsx src/judgeEval.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@microsoft/teams.apps": "^2.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
